# Flask runtime settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# App security (change these in production)
SECRET_KEY=change-this-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key
SECURITY_PASSWORD_SALT=change-this-password-salt
BLOODBANK_SECRET_KEY=change-this-blood-bank-secret-key

# Database and cache
SQLALCHEMY_DATABASE_URI=sqlite:///hospital.db
CACHE_TYPE=RedisCache
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/0
BLOODBANK_DB_PATH=/app/instance/bloodbank.db

# Gunicorn production tuning
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_LOG_LEVEL=info

# SMTP setup (Gmail shown as example)
SMTP_USERNAME=your-smtp-username@gmail.com
SMTP_PASSWORD=your-smtp-app-password
FROM_EMAIL=your-sender-email@gmail.com

# Optional app environment marker
APP_ENV=development
